<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.aemcp.bridge" ExtensionBundleVersion="0.2.1"
    ExtensionBundleName="Claude Bridge" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.aemcp.bridge.panel" Version="0.2.1" />
    <Extension Id="com.aemcp.bridge.console" Version="0.2.1" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="AEFT" Version="[22.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="11.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.aemcp.bridge.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
          <StartOn>
            <!-- Start the bridge in the background when AE launches, even if the panel is closed. -->
            <Event>com.adobe.csxs.events.ApplicationActivate</Event>
          </StartOn>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Claude Bridge</Menu>
          <Geometry>
            <Size><Height>260</Height><Width>340</Width></Size>
            <MinSize><Height>120</Height><Width>240</Width></MinSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
    <Extension Id="com.aemcp.bridge.console">
      <DispatchInfo>
        <Resources>
          <MainPath>./console.html</MainPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <!-- A panel (not Modeless): AE lists only panels under Window > Extensions.
               Undock it to use it as a floating box. -->
          <Type>Panel</Type>
          <Menu>Claude Console</Menu>
          <Geometry>
            <Size><Height>420</Height><Width>560</Width></Size>
            <MinSize><Height>200</Height><Width>360</Width></MinSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
